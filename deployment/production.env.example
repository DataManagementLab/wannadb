# Copy to wannadb_web/.env/.prod and restrict it to the deployment account.
DATABASE_NAME=userManagement
DATABASE_USER=postgres
DATABASE_PASSWORD=
# Use a separate hexadecimal secret, at least 32 characters.
CACHE_PASSWORD=
# Keep the existing backend signing secret when upgrading.
WANNA_DB_JWT_SECRET=
# Generate one additional secret with openssl rand -hex 32.
# Set the same AUTH_PROXY_SECRET in the frontend environment.
AUTH_PROXY_SECRET=
# Required only with the monitoring profile. Use username:password.
FLOWER_BASIC_AUTH=
